"" ====================================================================
"" Role Navigation
"" ====================================================================
function! JumpToRoleFile(subdir)
  let l:path = expand('%:p')
  let l:role_root = matchstr(l:path, '.*\/roles\/[^\/]\+\/')
  if empty(l:role_root)
    echo "Not inside a role"
    return
  endif
  let l:target = l:role_root . a:subdir . '/main.yml'
  if filereadable(l:target)
    execute 'edit ' . l:target
  else
    echo "Not found: " . l:target
  endif
endfunction

