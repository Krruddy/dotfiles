let g:project_dir = '~/docker-swarm-monitoring/ansible'


function! LoadRole(fname)
    let roles = "./roles/"
    let relativeRolePath = l:roles . a:fname . "/tasks/main.yml"
    let absoluteRolePath = g:project_dir . '/' . l:roles . a:fname . "/tasks/main.yml"

    if filereadable(l:relativeRolePath)
        return l:relativeRolePath
    elseif filereadable(l:absoluteRolePath)
        return l:absoluteRolePath
    else
        return l:roles . a:fname
    endif
endfunction

"" ====================================================================
"" NATIVE FILETYPE & PATH ROUTING
"" ====================================================================
augroup AnsibleNative
    autocmd!
    " Force filetype=yaml for extensions vim doesn't auto-detect
    autocmd BufRead,BufNewFile *.yml.j2,*.yaml.j2,.ansible-lint,.yamllint setlocal filetype=yaml

    " YAML-specific behavior
    autocmd FileType yaml setlocal keywordprg=ansible-doc
    autocmd FileType yaml setlocal suffixesadd=.yml,.yaml
    autocmd FileType yaml setlocal includeexpr=LoadRole(v:fname)
    autocmd FileType yaml setlocal iskeyword-=- iskeyword-=. iskeyword-=/
    autocmd FileType yaml setlocal foldmethod=expr foldexpr=YamlFolds() foldlevel=10
    autocmd FileType yaml setlocal path+=./group_vars/**,./inventory/**,./host_vars/**,./vars/**
    autocmd FileType yaml execute 'setlocal path+=.,' . expand('%:p:h') . '/../templates'
    autocmd FileType yaml nnoremap gD :grep '^\s*<cword>:' .<CR>:copen<CR>
    autocmd FileType yaml command! -nargs=1 GrepDir execute 'vimgrep ' . <q-args> . ' ' . g:project_dir . '/**'
    "ansible-lint --offline -p --nocolor -q -q
    autocmd FileType yaml setlocal makeprg=ansible-lint\ --format\ pep8\ -q\ -q\ --nocolor
    "ansible-lint --fix roles/vmalert_stack_deploy/defaults/main.yml --format pep8 2>/dev/null
    autocmd FileType yaml setlocal grepformat=%f:%l:\ %c:\ %m  

augroup END
