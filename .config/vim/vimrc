" Delete buffer without closing the split layout
function! BDeleteKeepSplit()
  let l:current = bufnr('%')
  let l:alternate = bufnr('#')

  if buflisted(l:alternate)
    buffer #
  else
    bnext
  endif

  if bufnr('%') != l:current
    execute 'bdelete! ' . l:current
  else
    execute 'bdelete'
  endif
endfunction

nnoremap <leader>q :call BDeleteKeepSplit()<CR> 
nnoremap <leader>Q :bdelete<CR>
